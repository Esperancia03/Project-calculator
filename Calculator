// SQLite Database class for storing results
class SQLiteDB {
private:
    sqlite3* db;

public:
    SQLiteDB() : db(nullptr) {}

    ~SQLiteDB() {
        sqlite3_close(db);
    }

    void openConnection() {
        int rc = sqlite3_open("calculator.db", &db);
        if (rc != SQLITE_OK) {
            cerr << "Error opening SQLite database: " << sqlite3_errmsg(db) << endl;
            sqlite3_close(db);
            exit(1);
        }
        createTables(); // Create necessary tables if they don't exist
    }

    void closeConnection() {
        sqlite3_close(db);
    }

    void saveResult(const string& tableName, double result) {
        string sql = "INSERT INTO " + tableName + " (result) VALUES (?);";
        sqlite3_stmt* stmt;
        int rc = sqlite3_prepare_v2(db, sql.c_str(), -1, &stmt, nullptr);
        if (rc != SQLITE_OK) {
            cerr << "Error preparing SQL statement: " << sqlite3_errmsg(db) << endl;
            return;
        }
        sqlite3_bind_double(stmt, 1, result);
        rc = sqlite3_step(stmt);
        if (rc != SQLITE_DONE) {
            cerr << "Error inserting data: " << sqlite3_errmsg(db) << endl;
        } else {
            cout << "Result saved successfully to SQLite." << endl;
        }
        sqlite3_finalize(stmt);
    }

private:
    void createTables() {
        string sql = "CREATE TABLE IF NOT EXISTS basic_operations (id INTEGER PRIMARY KEY AUTOINCREMENT, result REAL);";
        char* errMsg = nullptr;
        int rc = sqlite3_exec(db, sql.c_str(), nullptr, nullptr, &errMsg);
        if (rc != SQLITE_OK) {
            cerr << "Error creating basic_operations table: " << errMsg << endl;
            sqlite3_free(errMsg);
        }
    }
};

// Base class for operations
class Operations {
protected:
    SQLiteDB db;

public:
    Operations() {
        db.openConnection();
    }

    virtual ~Operations() {
        db.closeConnection();
    }

    virtual void displayMenu() const = 0;
    virtual void performOperation(int choice) = 0;
};

// Class for Basic Operations
class BasicOperations : public Operations {
public:
    void displayMenu() const override {
        cout << "=== Basic Operations ===" << endl;
        cout << "1. Addition" << endl;
        cout << "2. Subtraction" << endl;
        cout << "3. Multiplication" << endl;
        cout << "4. Division" << endl;
        cout << "5. Equality (Comparison)" << endl;
        cout << "Enter your choice (1-5): ";
    }

    void performOperation(int choice) override {
        switch (choice) {
            case 1:
                performAddition();
                break;
            case 2:
                performSubtraction();
                break;
            case 3:
                performMultiplication();
                break;
            case 4:
                performDivision();
                break;
            case 5:
                performEquality();
                break;
            default:
                cout << "Invalid choice." << endl;
                break;
        }
    }

private:
    void performAddition() {
        vector<double> numbers = getNumbers();
        double sum = 0.0;
        for (double num : numbers) {
            sum += num;
        }
        cout << "Result: " << sum << endl;
        db.saveResult("basic_operations", sum); // Save result to SQLite
    }

    void performSubtraction() {
        vector<double> numbers = getNumbers();
        if (numbers.size() < 2) {
            cout << "Error: Subtraction requires at least two numbers." << endl;
            return;
        }
        double result = numbers[0];
        for (size_t i = 1; i < numbers.size(); ++i) {
            result -= numbers[i];
        }
        cout << "Result: " << result << endl;
        db.saveResult("basic_operations", result); // Save result to SQLite
    }

    void performMultiplication() {
        vector<double> numbers = getNumbers();
        if (numbers.empty()) {
            cout << "Error: Multiplication requires at least one number." << endl;
            return;
        }
        double product = 1.0;
        for (double num : numbers) {
            product *= num;
        }
        cout << "Result: " << product << endl;
        db.saveResult("basic_operations", product); // Save result to SQLite
    }

    void performDivision() {
        vector<double> numbers = getNumbers();
        if (numbers.size() < 2) {
            cout << "Error: Division requires at least two numbers." << endl;
            return;
        }
        double result = numbers[0];
        for (size_t i = 1; i < numbers.size(); ++i) {
            if (numbers[i] == 0) {
                cout << "Error: Division by zero encountered." << endl;
                return;
            }
            result /= numbers[i];
        }
        cout << "Result: " << result << endl;
        db.saveResult("basic_operations", result); // Save result to SQLite
    }

    void performEquality() {
        vector<double> numbers = getNumbers();
        if (numbers.size() < 2) {
            cout << "Error: Equality comparison requires at least two numbers." << endl;
            return;
        }
        for (size_t i = 1; i < numbers.size(); ++i) {
            if (numbers[i] != numbers[0]) {
                cout << "Numbers are not equal." << endl;
                return;
            }
        }
        cout << "Numbers are equal." << endl;
    }

    vector<double> getNumbers() {
        int count;
        cout << "Enter the number of values: ";
        cin >> count;
        vector<double> numbers(count);
        for (int i = 0; i < count; ++i) {
            cout << "Enter number " << i + 1 << ": ";
            cin >> numbers[i];
        }
        return numbers;
    }
};

